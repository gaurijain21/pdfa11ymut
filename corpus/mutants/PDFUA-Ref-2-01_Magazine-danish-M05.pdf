                           <pdfaProperty:valueType>Real</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>When HasCrop is true, right of crop rectangle.</pdfaProperty:description>
                           <pdfaProperty:name>CropRight</pdfaProperty:name>
                           <pdfaProperty:valueType>Real</pdfaProperty:valueType>
                        </rdf:li>
